{
  "name": "browserpaw",
  "version": "5.0.0",
  "description": "Command-line browser automation through the BrowserPaw Chrome extension",
  "author": "hangye",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoldenLoaf24h/browserpaw.git",
    "directory": "app/native-server"
  },
  "homepage": "https://github.com/GoldenLoaf24h/browserpaw",
  "bin": {
    "browserpaw": "./dist/v5/cli.cjs"
  },
  "scripts": {
    "clean": "rimraf \"dist/v5\"",
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/v5/ --exec \"npm run build\"",
    "build": "ts-node src/scripts/build.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "prepack": "node scripts/pack-assets.cjs"
  },
  "files": [
    "dist/v5/cli.cjs",
    "dist/v5/host.cjs",
    "dist/v5/cli-files.cjs",
    "dist/v5/run_host.bat",
    "dist/v5/run_host.sh",
    "dist/v5/extension",
    "dist/v5/recipes",
    "dist/v5/skill"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "cli",
    "chrome",
    "browser"
  ],
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "chrome-mcp-shared": "workspace:*",
    "@types/node-fetch": "2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "node-fetch": "2",
    "tsup": "^8.5.1",
    "@jest/globals": "^29.7.0",
    "@types/chrome": "^0.0.318",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.31.1",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2"
  }
}
