{
  "name": "browserpaw-workspace",
  "version": "5.0.0",
  "description": "BrowserPaw Chrome automation CLI, extension, and Agent Skill",
  "private": true,
  "author": "hangye",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoldenLoaf24h/browserpaw.git"
  },
  "homepage": "https://github.com/GoldenLoaf24h/browserpaw",
  "bugs": {
    "url": "https://github.com/GoldenLoaf24h/browserpaw/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "release:check": "node scripts/release-notes.mjs",
    "verify:docs": "node scripts/validate-docs.mjs",
    "build:deploy": "pnpm build && node scripts/extension-artifacts.mjs --deploy",
    "verify:delivery": "node scripts/extension-artifacts.mjs --check-deployment",
    "build:shared": "pnpm --filter chrome-mcp-shared build",
    "build:native": "pnpm --filter browserpaw build",
    "build:extension": "pnpm --filter chrome-mcp-server build && node scripts/sync-extension-dist.mjs",
    "build": "pnpm -r run build && node scripts/sync-extension-dist.mjs",
    "dev:shared": "pnpm --filter chrome-mcp-shared dev",
    "dev:native": "pnpm --filter browserpaw dev",
    "dev:extension": "pnpm --filter chrome-mcp-server dev",
    "dev": "pnpm --filter chrome-mcp-shared build && pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:e2e": "node test/live/chrome-cli.mjs",
    "docs:commands": "node scripts/gen-commands-doc.mjs",
    "lint": "eslint scripts test/live test/package-smoke.mjs app/native-server/src app/native-server/scripts app/chrome-extension packages/shared/src --max-warnings=0",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "clean:dist": "node scripts/clean.js dist",
    "clean:modules": "node scripts/clean.js modules",
    "clean": "node scripts/clean.js all",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.25.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vue-eslint-parser": "^10.1.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "node node_modules/eslint/bin/eslint.js --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "license": "AGPL-3.0-or-later"
}
