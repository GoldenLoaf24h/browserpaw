{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "browserpaw",
  "version": "5.0.1",
  "description": "Control your own Chrome browser with BrowserPaw.",
  "author": {
    "name": "BrowserPaw Team",
    "url": "https://github.com/GoldenLoaf24h/browserpaw"
  },
  "homepage": "https://github.com/GoldenLoaf24h/browserpaw",
  "repository": "https://github.com/GoldenLoaf24h/browserpaw",
  "license": "AGPL-3.0-or-later",
  "keywords": ["browser", "chrome", "automation", "cli", "agent", "cdp"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "BrowserPaw",
        "shortDescription": "Automate your Chrome session",
        "longDescription": "Automate your everyday Chrome or Chromium session through the BrowserPaw CLI and self-learning site workflows while reusing existing logins and extensions.",
        "developerName": "BrowserPaw Team",
        "category": "Productivity",
        "capabilities": [
          "Browser Automation",
          "CLI Workflow Control",
          "Learned Site Recipes",
          "Session Reuse"
        ],
        "websiteURL": "https://github.com/GoldenLoaf24h/browserpaw",
        "privacyPolicyURL": "https://github.com/GoldenLoaf24h/browserpaw/blob/main/PRIVACY.md",
        "supportURL": "https://github.com/GoldenLoaf24h/browserpaw/issues",
        "defaultPrompt": [
          "Open Chrome and inspect my active webpage",
          "Search the active page and extract the key items",
          "Check BrowserPaw connection status and learned site recipes"
        ],
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      },
      "requires_local_executor": true
    }
  }
}
